<script>
function renderTable(data){
  const rows = data.map(o=>[o.patient_id,o.age,o.sex,o.n_visits,Number(o.hr_last).toFixed(3),Number(o.sbp_last).toFixed(3),Number(o.wbc_last).toFixed(3),o.diag_last,Number(o.wbc_trend).toFixed(3),Number(o.hr_trend).toFixed(3),o.label]);
  if(window.jQuery && $.fn.DataTable){
    $('#ehr-table').DataTable({data:rows, pageLength:10, lengthMenu:[10,25,50], order:[[0,'asc']], scrollX:true});
  } else {
    const tbody=document.querySelector('#ehr-table tbody');
    rows.slice(0,10).forEach(r=>{const tr=document.createElement('tr'); r.forEach(v=>{const td=document.createElement('td'); td.textContent=v; tr.appendChild(td)}); tbody.appendChild(tr)});
  }
}
// Try fetch first (works via http server), fallback to inline data (works via file://)
fetch('data_preview.json').then(r=>{if(!r.ok) throw new Error(r.status); return r.json()}).then(renderTable).catch(e=>{
  console.warn('fetch failed, using inline data',e);
  try{
    const inline=JSON.parse(document.getElementById('ehr-data').textContent);
    // fetch full preview if inline is only sample: duplicate sample to show table works, then try to load full via XHR silently
    fetch('data_preview.json').then(r=>r.json()).then(renderTable).catch(()=>renderTable(inline));
    renderTable(inline);
  }catch(err){document.querySelector('#ehr-table tbody').innerHTML='<tr><td colspan=11 style="color:#b91c1c">Failed to load data_preview.json — please open via http://127.0.0.1:8765/ (not file://) or check docs/data_preview.json exists.</td></tr>';}
});
</script>
</body>
</html>
