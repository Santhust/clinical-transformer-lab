<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Clinical Transformer Lab — Classical and Transformer Models for Sequential Medical Prediction</title>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css">
<style>
:root{--bg:#f8fafc;--card:#ffffff;--accent:#2563eb;--text:#0f172a;--muted:#64748b;--border:#e2e8f0}
*{box-sizing:border-box} body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial;background:var(--bg);color:var(--text);line-height:1.65}
