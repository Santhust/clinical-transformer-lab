.badge{display:inline-block;background:rgba(255,255,255,.18);padding:.25rem .65rem;border-radius:999px;font-size:.78rem;margin:.2rem;border:1px solid rgba(255,255,255,.2)}
main{max-width:980px;margin:-1.5rem auto 2rem;padding:0 1rem}
.card{background:var(--card);border-radius:16px;padding:1.5rem 1.6rem;box-shadow:0 6px 24px rgba(15,23,42,.06);margin:1.25rem 0;border:1px solid var(--border)}
h2{margin:0 0 .6rem;color:#1e3a8a;font-size:1.35rem} h3{color:#1e40af;margin:1.2rem 0 .4rem;font-size:1.05rem}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
@media(max-width:760px){.grid2{grid-template-columns:1fr}}
img{max-width:100%;border-radius:12px;border:1px solid var(--border);background:white}
.kpi{display:flex;gap:.8rem;flex-wrap:wrap;margin:.8rem 0} .kpi div{flex:1;min-width:135px;background:#f1f5f9;border-radius:12px;padding:.9rem;text-align:center;border:1px solid var(--border)}
.kpi strong{font-size:1.35rem;display:block}
a{color:#2563eb} code{background:#f1f5f9;padding:.15rem .35rem;border-radius:6px;font-size:.9em}
